{
  "name": "netronome",
  "version": "2.6.0",
  "description": "Rock solid JavaScript timing library with sub-millisecond accuracy",
  "keywords": [
    "timing",
    "clock",
    "metronome",
    "bpm",
    "tempo",
    "audio",
    "scheduling",
    "javascript"
  ],
  "homepage": "https://designerzen.github.io/netronome/",
  "bugs": {
    "url": "https://github.com/designerzen/netronome/issues"
  },
  "source": "src/index.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/designerzen/netronome.git"
  },
  "author": "designerzen",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.3.5",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "terser": "^5.46.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "scripts": {
    "cert": "mkcert -install && mkcert -cert-file ./certs/localhost.pem -key-file ./certs/localhost-key.pem localhost 127.0.0.1 ::1",
    "build": "vite build && vite build -c vite.lib.config.ts --mode lib && tsc -p tsconfig.lib.json --emitDeclarationOnly && node -e \"require('fs').copyFileSync('dist/main.js','dist/timing-worklet.js')\"",
    "start": "vite",
    "dev": "vite",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "lint:types": "tsc --strict --noEmit",
    "upgrader": "npx npm-check-updates --interactive -u"
  }
}
