{
  "name": "netronome",
  "version": "2.7.1",
  "description": "Rock solid JavaScript timing library with sub-millisecond accuracy",
  "keywords": [
    "timing",
    "clock",
    "metronome",
    "bpm",
    "tempo",
    "audio",
    "scheduling",
    "javascript"
  ],
  "homepage": "https://designerzen.github.io/netronome/",
  "bugs": {
    "url": "https://github.com/designerzen/netronome/issues"
  },
  "source": "src/index.ts",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "dist/timing.audioworklet.js",
    "dist/timing.audioworklet.js.map",
    "dist/elastic-timing.audioworklet.js",
    "dist/elastic-timing.audioworklet.js.map",
    "dist/elastic-timing.audioworklet-processor.js",
    "dist/elastic-timing.audioworklet-processor.js.map",
    "dist/*.d.ts",
    "dist/*.d.ts.map",
    "dist/workers/*.js",
    "dist/workers/*.js.map",
    "dist/workers/*.d.ts",
    "dist/workers/*.d.ts.map",
    "dist/worklets/*.d.ts",
    "dist/worklets/*.d.ts.map",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/designerzen/netronome.git"
  },
  "author": "designerzen",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/ui": "^4.1.6",
    "terser": "^5.47.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  },
  "scripts": {
    "preinstall": "node -e \"const ua=process.env.npm_config_user_agent||''; if(!ua.includes('pnpm/')){console.error('\\nThis repository uses pnpm exclusively.\\nRun: pnpm install\\n'); process.exit(1)}\"",
    "cert": "mkcert -install && mkcert -cert-file ./certs/localhost.pem -key-file ./certs/localhost-key.pem localhost 127.0.0.1 ::1",
    "build": "vite build && pnpm build:lib",
    "build:lib": "vite build -c vite.lib.config.ts && vite build -c vite.workers.config.ts && tsc -p tsconfig.build.json",
    "start": "vite",
    "dev": "vite",
    "signal": "node ./scripts/sync-signaling-server.mjs",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "lint:types": "tsc --strict --noEmit",
    "upgrader": "npx npm-check-updates --interactive -u"
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "qrcode": "^1.5.4",
    "zxing-wasm": "^3.0.3"
  }
}
